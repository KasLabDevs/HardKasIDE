{
  "name": "@hardkas-ide/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local server for HardKas IDE: workspace file system, hardkas CLI jobs, dev-server proxy.",
  "bin": {
    "hardkas-ide-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/node-ws": "^1.3.1",
    "@lydell/node-pty": "1.2.0-beta.18",
    "adm-zip": "^0.6.1",
    "hash-wasm": "^4.12.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
