{
  "name": "@hardkas-ide/mcp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for HardKas IDE: lets an AI agent compile SilverScript, run the local node, move test coins and deploy contracts through the IDE server.",
  "bin": {
    "hardkas-ide-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "call": "tsx scripts/call.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
