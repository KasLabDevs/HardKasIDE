{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HardKas IDE",
  "version": "0.1.0",
  "identifier": "dev.kaslabdevs.hardkas-ide",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../.. dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HardKas IDE",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["stage/**/*"],
    "shortDescription": "A workbench for HardKas (Kaspa) projects",
    "longDescription": "HardKas IDE: editor, SilverScript compiler, Deploy & Run, artifacts, node explorer and terminals for HardKas projects on Kaspa.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Spanish"]
      }
    }
  }
}
